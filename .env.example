# Optional. Copy to .env and start the service with:  node --use-system-ca --env-file=.env server/index.mjs
# The key is read only by the local server (server/index.mjs) and is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional polite-pool contact for OpenAlex when refreshing the literature snapshot
OPENALEX_MAILTO=
PORT=8787
